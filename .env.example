# ==============================================================================
# Farmer AI Advisory System - Environment Configuration Template
# NOTE: Do NOT place real secrets in this file. Copy to .env and configure.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://farmer-ai-advisor.vercel.app

# Database & Storage (Supabase / PostgreSQL with pgvector)
# Required in production/staging. In dev, falls back to SQLite if unset.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Speech-to-Text & Text-to-Speech Provider (Sarvam AI)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_ENDPOINT=https://api.sarvam.ai/text-to-speech

# LLM Providers (Google Gemini Flash)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.8-flash

# Text Embeddings Provider (768 dimensions for pgvector compatibility)
# In development, DeterministicMockEmbeddingProvider is used if GEMINI_API_KEY is unset.
# In staging/production, GEMINI_API_KEY is required and mock embeddings are strictly prohibited.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.55

# Government Agricultural Data APIs (Data.gov.in / Agmarknet)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
AGMARKNET_CACHE_TTL_SECONDS=21600

# Rate Limiting & Proxy Configuration
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false

# Upload & Fallback Configuration
MAX_AUDIO_UPLOAD_SIZE_MB=15
ENABLE_MOCK_FALLBACK=true

# Frontend Client Configuration (Vercel)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
