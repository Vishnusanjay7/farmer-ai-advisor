# ==============================================================================
# Farmer AI Advisory Assistant - Backend Environment Configuration Template
# NOTE: Place real secrets only in your local .env or cloud hosting dashboard.
# NEVER commit real credentials to version control.
# ==============================================================================

# Application Environment (development | staging | production)
# In production/staging, DATABASE_URL is mandatory and cannot be SQLite.
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Server Network Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Configuration (Comma-separated list of allowed origins)
# In production/staging, wildcards ('*') are strictly prohibited.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://farmer-ai-advisor.vercel.app

# Database & Vector Storage (Supabase / PostgreSQL with pgvector)
# Required in production/staging. In development, defaults to local SQLite if unset.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Speech-to-Text & Text-to-Speech (Sarvam AI)
# Required in production/staging for regional voice interaction.
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_ENDPOINT=https://api.sarvam.ai/text-to-speech

# Conversational Agricultural LLM (Google Gemini Flash)
# Required in production/staging. Model must be gemini-3.8-flash.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.8-flash

# Vector Embeddings (768 Dimensions)
# Development falls back to DeterministicMockEmbeddingProvider if GEMINI_API_KEY is unset.
# Staging and Production require GEMINI_API_KEY and fail closed without silent fallback.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.55

# Government Agricultural Market Data (Data.gov.in / Agmarknet)
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
AGMARKNET_CACHE_TTL_SECONDS=21600

# Instance-Local Rate Limiting (Hackathon Safeguard)
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false

# Audio Upload Constraint
MAX_AUDIO_UPLOAD_SIZE_MB=15
ENABLE_MOCK_FALLBACK=true
