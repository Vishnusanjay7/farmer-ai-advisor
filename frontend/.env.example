# ==============================================================================
# Farmer AI Advisory Assistant - Frontend Environment Configuration Template
# NOTE: This variable is baked into the Next.js client bundle at build/runtime.
# NEVER place server-side secrets (GEMINI_API_KEY, SARVAM_API_KEY, etc.) here.
# ==============================================================================

# URL of the deployed FastAPI backend service.
# Development default: http://localhost:8000
# Production example: https://farmer-ai-advisor-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
